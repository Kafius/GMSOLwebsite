---
import { Image } from 'astro:assets';
import socan from '../assets/logos/socan.png';
import GMS from '../assets/logos/GMS_LOGO.jpg';
import dataverse from '../assets/logos/dataverse.jpg';
import H2 from './headerfont/H2.astro';

const clients = [
    { src: socan, name: "SOCAN", alt: "SOCAN Logo", link: "https://www.socan.com", caption: "SOCAN represents over 185,000 music creators and publishers, licensing music and distributing royalties in Canada and worldwide." },
    { src: GMS, name: "Global Music Solutions", alt: "GMS Logo", link: "https://www.globalmusicsolutions.ca", caption: "Find out the benefits to being one of our partners here!" },
    { src: dataverse, name: "Dataverse", alt: "Dataverse Logo", link: "https://dataverse.ph", caption: "Dataverse is a Canadian non-profit organization that provides a free and open-source web application to help researchers store, share, publish, and analyze their research data." }
];
---

<section class="bg-cream py-32 px-6 lg:px-12 border-t border-onyx/5">
  <div class="max-w-7xl mx-auto">

    <div class="mb-20 flex flex-col lg:flex-row justify-between lg:items-baseline gap-4">
      <div class="border-l-4 border-brand-red pl-8">
        <H2 class="leading-none text-onyx">
          Our <span class="italic" style="color: #A53029">Partners</span>
        </H2>
        <p class="mt-4 font-mono text-[10px] uppercase tracking-[0.4em] text-onyx/40">Trusted Affiliations // 2026</p>
      </div>
      <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-onyx/40 lg:text-right">
        // Hover_to_learn_more
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 border-l border-t border-onyx/10">
      {clients.map(client => (
        <a
          href={client.link}
          target="_blank"
          rel="noopener noreferrer"
          title={client.caption}
          aria-label={`${client.name} — ${client.caption}`}
          class="group flex items-center justify-center p-12 lg:p-16 min-h-[260px] border-r border-b border-onyx/10 transition-colors duration-500 hover:bg-linen"
        >
          <Image
            src={client.src}
            alt={client.alt}
            width={400}
            class="w-auto h-auto object-contain max-h-[72px] max-w-[190px] grayscale opacity-60 mix-blend-multiply transition-all duration-700 ease-in-out group-hover:grayscale-0 group-hover:opacity-100"
          />
        </a>
      ))}
    </div>

    <div class="mt-8 flex justify-end items-center">
      <div class="h-[1px] w-24 bg-onyx self-center mr-4 opacity-20"></div>
      <p class="text-[10px] uppercase tracking-widest font-bold text-onyx">Building Global Connections</p>
    </div>

  </div>
</section>
