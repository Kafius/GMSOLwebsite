---
import H2 from './headerfont/H2.astro';
import H4 from './headerfont/H4.astro';

const stats = [
  { 
    number: "05", 
    label: "Years in Business", 
    description: "Establishing a legacy of excellence in the performing rights sector." 
  },
  { 
    number: "15", 
    label: "QA Mastery", 
    description: "Years specialized in cue sheet quality assurance for global outsource firms." 
  },
  { 
    number: "30", 
    label: "Processing Expertise", 
    description: "Years of high-productivity, cost-effective cue sheet processing solutions." 
  }
];
---

<section class="bg-linen py-24 px-6 lg:px-12 border-t border-onyx/5">
  <div class="max-w-7xl mx-auto">
    
    <div class="mb-20 flex flex-col lg:flex-row justify-between items-baseline gap-4">
      <H2 class="text-4xl lg:text-5xl text-onyx">
        Proven <span class="text-brand-red">Experience</span>
      </H2>
      <p class="font-sans text-xs uppercase tracking-[0.3em] text-onyx/40">
        // Performance Metrics / 2026
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-0 border-l border-t border-onyx">
      {stats.map((stat) => (
        <div class="group p-10 border-r border-b border-onyx hover:bg-onyx transition-colors duration-700">
          <div class="flex flex-col h-full justify-between">
            <div>
              <span class="block font-heading text-7xl lg:text-8xl leading-none tracking-tighter text-onyx group-hover:text-porcelain transition-colors duration-500">
                {stat.number}
              </span>
              <H4 class="mt-6 tracking-widest text-onyx group-hover:text-porcelain transition-colors duration-500">
                {stat.label}
              </H4>
            </div>
            
            <p class="mt-12 font-sans text-sm leading-relaxed text-onyx/60 group-hover:text-porcelain/60 transition-colors duration-500 max-w-[250px]">
              {stat.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-8 flex justify-end items-center">
        <div class="h-[1px] w-24 bg-onyx self-center mr-4 opacity-20"></div>
        <p class="text-xs uppercase tracking-widest font-bold text-onyx">Industry Standard Verified</p>
    </div>
  </div>
</section>