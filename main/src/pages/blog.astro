---
import Layout from '../layouts/Layout.astro';
import { getAllPosts, type Post } from '../lib/queries';
import BannerBlog from '../components/banners/BannerBlog.astro';

const posts = await getAllPosts();
---

<Layout
  title="Archive | GMS"
  description="Browse the Global Music Solutions blog archive for industry insights on music royalties, cue sheets, and performing rights."
>
  <div class="bg-porcelain text-onyx">
    <BannerBlog/>

    <main class="py-32 max-w-7xl mx-auto px-6">
      <div class="flex items-center gap-4 mb-8">
        <span class="font-sans text-brand-red text-xs uppercase tracking-[0.5em]">// File_Index</span>
        <div class="h-[1px] flex-grow bg-onyx/10"></div>
      </div>

      <h1 class="font-heading text-6xl lg:text-8xl uppercase tracking-tighter mb-16">Archive</h1>

      <div class="flex flex-col border-t border-onyx">
        {posts.map((post: Post) => (
          <a href={`/blog/${post.slug.current}`} class="py-8 border-b border-onyx/10 group block">
            <div class="flex flex-col md:flex-row md:items-center gap-8">
              <div class="w-full md:w-48 h-32 overflow-hidden bg-onyx">
                <img
                  src={post.image}
                  alt={post.title}
                  loading="lazy"
                  decoding="async"
                  width="192"
                  height="128"
                  class="w-full h-full object-cover grayscale opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
                />
              </div>
              <div class="flex-grow grid grid-cols-1 md:grid-cols-12 items-center gap-4">
                <div class="md:col-span-2">
                  <span class="font-sans text-sm text-brand-red">{post.date}</span>
                </div>
                <div class="md:col-span-8">
                  <h2 class="font-heading text-2xl lg:text-3xl uppercase tracking-tight group-hover:italic transition-all">
                    {post.title}
                  </h2>
                </div>
                <div class="md:col-span-2 text-right">
                  <span class="font-sans text-xs uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity underline decoration-brand-red underline-offset-4">
                    Open_File
                  </span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </main>
  </div>
</Layout>
